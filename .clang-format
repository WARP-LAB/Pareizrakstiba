# Documentation/process/clang-format.rst
# https://clang.llvm.org/docs/ClangFormat.html
# https://clang.llvm.org/docs/ClangFormatStyleOptions.html

# This config style does not use BasedOnStyle directive
# but rather copies config used in Linux kernel
# <https://github.com/torvalds/linux/blob/master/.clang-format>
# <https://docs.kernel.org/dev-tools/clang-format.html>

---
BasedOnStyle: LLVM
IndentWidth: 2
TabWidth: 2
UseTab: Never
SortIncludes: false
ReflowComments: false
# SpacesInBlockComments: Leave # v24

# ObjC directives
ObjCBinPackProtocolList: Auto
ObjCBlockIndentWidth: 2
ObjCBreakBeforeNestedBlockParam: false
# ObjCPropertyAttributeOrder # unsafe
# ObjCSpaceAfterMethodDeclarationPrefix: true # v23
ObjCSpaceAfterProperty: true
ObjCSpaceBeforeProtocolList: true

---
Language: ObjC

# General
# SpacesBeforeTrailingComments: 1
# AllowShortIfStatementsOnASingleLine: Never
# AllowShortFunctionsOnASingleLine: Empty

# Keep the long-winded comments?
ReflowComments: true
ColumnLimit: 80

# For Obj-C++
Standard: c++14

# Brace yourself
# Allman for methods and Stroustrup for everything else
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: false
  # AfterRequiresExpression: true
  AfterStruct: false
  AfterUnion: false
  # AfterExportBlock: true
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

...
