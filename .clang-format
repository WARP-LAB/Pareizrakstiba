# This is kroko's clang format for ObjC project
# keeping square-bracket notation for now
# Based on LLVM
# https://clang.llvm.org/docs/ClangFormat.html
# https://clang.llvm.org/docs/ClangFormatStyleOptions.html

---
BasedOnStyle: LLVM

# same as LLVM, kept explicit
IndentWidth: 2
TabWidth: 2
UseTab: Never

# LLVM default is 80
ColumnLimit: 100

ReflowComments: false
# SpacesInBlockComments: Leave # available from v24
SpacesBeforeTrailingComments: 1

SortIncludes: false

AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortFunctionsOnASingleLine: Empty

# Brace yourself
# Break before function/method bodies (Allman) else and catch;
# attach everything else
BreakBeforeBraces: Stroustrup

# ObjC directives
ObjCBinPackProtocolList: Auto
ObjCBlockIndentWidth: 2
ObjCBreakBeforeNestedBlockParam: false
# ObjCPropertyAttributeOrder # unsafe
# ObjCSpaceAfterMethodDeclarationPrefix: true # available from v23
ObjCSpaceAfterProperty: true
ObjCSpaceBeforeProtocolList: true

---
Language: ObjC

# For Obj-C++, align with std Hunspell is tested against and thus
# we use for CLANG_CXX_LANGUAGE_STANDARD in this project
Standard: c++14

...
